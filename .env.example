# Copy this to repository-root .env only if .env does not exist; otherwise edit
# the existing file without overwriting secrets. Backend settings load .env;
# process environment wins. Never put secrets in VITE_* variables.
AUTH_DEMO_MODE=false
AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECONDS=28800
# Local same-origin Vite proxy; use HTTPS and Secure=true outside loopback.
AUTH_PUBLIC_BASE_URL=http://127.0.0.1:5173/controller-api
AUTH_FRONTEND_URL=http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate at least 32 random bytes; distribute only to controller, worker,
# inventory, order service and trusted verification scripts.
INTERNAL_SERVICE_TOKEN=
AUTH_RESET_SECRET=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=
AUTH_SMTP_FROM=
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
VITE_ORDER_API_URL=/order-api
VITE_CONTROLLER_API_URL=/controller-api
ORDER_API_UPSTREAM=http://127.0.0.1:8000
CONTROLLER_API_UPSTREAM=http://127.0.0.1:8003
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
