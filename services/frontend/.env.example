# Same-origin paths use Vite's development/preview proxy.
VITE_ORDER_API_URL=/order-api
VITE_CONTROLLER_API_URL=/controller-api
# Set these to your running backend addresses. No default endpoints are assumed.
ORDER_API_UPSTREAM=
CONTROLLER_API_UPSTREAM=
FRONTEND_HOST=
FRONTEND_PORT=
FRONTEND_PREVIEW_PORT=
